zigbee.db
zigbee.db-wal
zigbee.db-shm

# Logs
home-assistant.log*
*.log

# Secrets & credentials
secrets.yaml
!secrets.example.yaml

# UI state & registry (exported selectively by Git Exporter, not raw)
.storage/

# Cloud, caches, transient
.cloud/
deps/
tts/
